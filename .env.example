# =================================================================
# ROSE CARD PLATFORM — Variables de Entorno — EJEMPLO
# TSolutions vCards · Archivo de referencia para nuevos entornos
# =================================================================
# ✅ Este archivo SÍ se sube a GitHub — NO contiene valores reales.
# 📋 Copia este archivo como .env y completa los valores.
#    cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. BASE DE DATOS — PostgreSQL
#    Neon.tech (recomendado): https://neon.tech
#    Formato Pooled: postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require
# -----------------------------------------------------------------
DATABASE_URL="postgresql://usuario:contraseña@host:5432/database?sslmode=require"

# -----------------------------------------------------------------
# 2. NEXTAUTH — Autenticación & Sesiones
#    Generar secret: openssl rand -base64 32
# -----------------------------------------------------------------
NEXTAUTH_URL="https://tu-dominio.com"
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"

# -----------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0
#    Crear en: https://console.cloud.google.com/apis/credentials
#    URI de redireccionamiento: https://tu-dominio.com/api/auth/callback/google
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------
# 4. STRIPE — Pasarela de Pagos
#    Dashboard: https://dashboard.stripe.com/apikeys
#    Webhook: https://dashboard.stripe.com/webhooks
# -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------
# 5. CONFIGURACIÓN PÚBLICA DEL SITIO
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
NEXT_PUBLIC_BRAND_NAME="Tu Marca"
NEXT_PUBLIC_COMPANY_NAME="Tu Empresa S.A. de C.V."
NEXT_PUBLIC_SUPPORT_EMAIL="contacto@tu-dominio.com"

# -----------------------------------------------------------------
# 6. PANEL ADMINISTRATIVO — Control de Acceso
# -----------------------------------------------------------------
ALLOWED_ADMIN_DOMAINS="tu-dominio.com"

# -----------------------------------------------------------------
# 7. APPLE WALLET — Firma PKCS#7 (.pkpass)
#    Requiere membresía Apple Developer Program ($99 USD/año)
#    https://developer.apple.com/account/resources/certificates
# -----------------------------------------------------------------
APPLE_PASS_TYPE_ID="pass.com.tu-empresa.nfc"
APPLE_TEAM_ID="TU_TEAM_ID_10_CHARS"
APPLE_PASS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_PASS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------
# 8. GOOGLE WALLET — JWT RS256
#    Crear Service Account: https://console.cloud.google.com/iam-admin/serviceaccounts
#    Activar API: https://console.cloud.google.com/apis/library/walletobjects.googleapis.com
# -----------------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLASS_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL="service-account@proyecto.iam.gserviceaccount.com"
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------
# 9. SERVICIO DE EMAIL — Recuperación de Contraseña
#    Resend (recomendado): https://resend.com/api-keys
# -----------------------------------------------------------------
RESEND_API_KEY="re_..."
# Alternativa SMTP (descomentar si no usas Resend):
# SMTP_HOST="smtp.proveedor.com"
# SMTP_PORT="587"
# SMTP_USER="tu@correo.com"
# SMTP_PASS="contraseña-smtp"
# SMTP_FROM="noreply@tu-dominio.com"

# -----------------------------------------------------------------
# 10. WEBHOOKS & AUTOMATIZACIÓN (Opcional)
#     URL de Zapier, Make, HubSpot, Salesforce, etc.
# -----------------------------------------------------------------
GLOBAL_WEBHOOK_URL=""

# -----------------------------------------------------------------
# 11. OCR — Google Vision API (Opcional)
#     Para escaneo de tarjetas físicas → lead digital
#     https://console.cloud.google.com/apis/library/vision.googleapis.com
# -----------------------------------------------------------------
GOOGLE_VISION_API_KEY=""
