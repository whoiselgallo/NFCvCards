# ======================================================================
# CONFIGURACIÓN DE ENTORNO - ROSE CARD / NFC VCARDS MARCA BLANCA
# ======================================================================

# 1. Base de Datos PostgreSQL (Supabase, Neon, Google Cloud SQL, Railway o Local)
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/nfc_vcards?sslmode=disable

# 2. Clave secreta para autenticación de administradores (JWT/Cookies)
AUTH_SECRET=genera-una-clave-secreta-aleatoria-y-segura-2026

# 3. Restricción de dominios para el registro y login en /admin
# Usa '*' para permitir cualquier correo válido, o una lista de dominios separados por coma:
# Ejemplo: ALLOWED_ADMIN_DOMAINS=@rosecard.io,@miempresa.com
ALLOWED_ADMIN_DOMAINS=*

# 4. Variables Públicas de Marca (Opcionales - Sobrescriben brand.config.js)
NEXT_PUBLIC_BRAND_NAME=ROSE Card
NEXT_PUBLIC_COMPANY_NAME=ROSE Card Digital
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=contacto@rosecard.io
