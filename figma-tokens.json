{
  "$schema": "https://tokens.studio/schemas/token-set.json",
  "name": "ROSE Card - Cyber vCard Engine Tokens",
  "version": "1.1.0",
  "description": "Design Tokens oficiales de ROSE Card con Tipografía Principal Plaster y Tipografía Corporativa Rosetta Tech Sans.",
  "global": {
    "color": {
      "paleta-principal": {
        "rojo-nucleo": {
          "value": "#C8102E",
          "type": "color",
          "description": "Rojo Núcleo Principal de la Marca. RGB(200, 16, 46). Uso: Botones primarios, branding corporativo, contornos destacados."
        },
        "carmesi-geometrico": {
          "value": "#EE334E",
          "type": "color",
          "description": "Carmesí Geométrico. RGB(238, 51, 78). Uso: Focos neón, estados hover, títulos y resplandor de circuitos."
        },
        "gris-circuito": {
          "value": "#B1B3B3",
          "type": "color",
          "description": "Gris Circuito. RGB(177, 179, 179). Uso: Textos secundarios, pistas de circuito, líneas divisorias e iconos."
        },
        "negro-profundo": {
          "value": "#0A0A0A",
          "type": "color",
          "description": "Negro Profundo. RGB(10, 10, 10). Uso: Fondo principal inmersivo y paneles de contraste extremo."
        }
      },
      "paleta-secundaria": {
        "gris-apoyo": {
          "value": "#EBEBF2",
          "type": "color",
          "description": "Gris de Apoyo. RGB(235, 235, 242). Uso: Superficies claras, fondos alternos y tipografía de alto contraste."
        },
        "azul-tecnologico": {
          "value": "#4A7AFF",
          "type": "color",
          "description": "Azul Tecnológico (Subtle, cool accent). RGB(74, 122, 255). Uso: Badges tecnológicos, enlaces activos y acentos fríos."
        },
        "plata-metalizado": {
          "value": "#D9DADC",
          "type": "color",
          "description": "Plata Metalizado (For highlights). RGB(217, 218, 220). Uso: Biseles, reflejos metálicos, bordes de cristal y brillos."
        },
        "sombra-carmesi": {
          "value": "#9A0020",
          "type": "color",
          "description": "Sombra Carmesí. RGB(154, 0, 32). Uso: Sombras facetadas, gradientes oscuros y estados active/pressed."
        }
      },
      "semantic": {
        "background": {
          "primary": { "value": "{color.paleta-principal.negro-profundo}", "type": "color" },
          "panel": { "value": "#121114", "type": "color" },
          "surface-light": { "value": "{color.paleta-secundaria.gris-apoyo}", "type": "color" }
        },
        "text": {
          "primary": { "value": "#FFFFFF", "type": "color" },
          "secondary": { "value": "{color.paleta-principal.gris-circuito}", "type": "color" },
          "brand-neon": { "value": "{color.paleta-principal.carmesi-geometrico}", "type": "color" },
          "brand-ruby": { "value": "{color.paleta-principal.rojo-nucleo}", "type": "color" },
          "accent-blue": { "value": "{color.paleta-secundaria.azul-tecnologico}", "type": "color" }
        },
        "border": {
          "subtle": { "value": "rgba(200, 16, 46, 0.30)", "type": "color" },
          "highlight": { "value": "{color.paleta-secundaria.plata-metalizado}", "type": "color" },
          "glow": { "value": "{color.paleta-principal.carmesi-geometrico}", "type": "color" }
        }
      }
    },
    "fontFamilies": {
      "brand-primary": {
        "value": "Plaster",
        "type": "fontFamilies",
        "description": "Tipografía Principal de Marca / Display (Plaster). Utilizada para el logotipo rose vcard, monogramas e isotipos de impacto."
      },
      "corporate-secondary": {
        "value": "Rosetta Tech Sans",
        "type": "fontFamilies",
        "description": "Tipografía Secundaria de Marca (Rosetta Tech Sans). Fuente recomendada para comunicación corporativa adyacente al logo y subtítulos."
      },
      "body-ui": {
        "value": "Inter",
        "type": "fontFamilies",
        "description": "Tipografía de Lectura, Formularios y UI de Interfaz."
      }
    },
    "typography": {
      "brand-logo": {
        "value": {
          "fontFamily": "{fontFamilies.brand-primary}",
          "fontWeight": "Regular",
          "fontSize": "32px",
          "lineHeight": "1.1",
          "letterSpacing": "2px",
          "textCase": "lowercase"
        },
        "type": "typography",
        "description": "Estilo del logotipo institucional 'rose vcard' con acento rojo en 's'."
      },
      "corporate-heading": {
        "value": {
          "fontFamily": "{fontFamilies.corporate-secondary}",
          "fontWeight": "Regular",
          "fontSize": "24px",
          "lineHeight": "1.3",
          "letterSpacing": "1px",
          "textCase": "uppercase"
        },
        "type": "typography",
        "description": "Estilo para titulares corporativos y subtítulos de producto."
      },
      "body-regular": {
        "value": {
          "fontFamily": "{fontFamilies.body-ui}",
          "fontWeight": "400",
          "fontSize": "15px",
          "lineHeight": "1.5",
          "letterSpacing": "0px"
        },
        "type": "typography"
      }
    },
    "boxShadow": {
      "glow-rose": {
        "value": {
          "x": "0",
          "y": "0",
          "blur": "16",
          "spread": "0",
          "color": "rgba(200, 16, 46, 0.45)",
          "type": "dropShadow"
        },
        "type": "boxShadow"
      },
      "glow-rose-hover": {
        "value": {
          "x": "0",
          "y": "0",
          "blur": "26",
          "spread": "0",
          "color": "rgba(238, 51, 78, 0.70)",
          "type": "dropShadow"
        },
        "type": "boxShadow"
      },
      "glow-blue-tech": {
        "value": {
          "x": "0",
          "y": "0",
          "blur": "14",
          "spread": "0",
          "color": "rgba(74, 122, 255, 0.35)",
          "type": "dropShadow"
        },
        "type": "boxShadow"
      }
    },
    "borderRadius": {
      "soft": { "value": "10px", "type": "borderRadius" },
      "medium": { "value": "14px", "type": "borderRadius" },
      "large": { "value": "18px", "type": "borderRadius" },
      "full": { "value": "9999px", "type": "borderRadius" }
    }
  }
}
